# Replicate API Token — replicate.com/account/api-tokens 에서 발급
REPLICATE_API_TOKEN=

# Gemini API Key — aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

# 카카오 JavaScript SDK App Key
NEXT_PUBLIC_KAKAO_APP_KEY=

# Rate Limit 설정 (IP당 윈도우 내 최대 요청 수)
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_SEC=60

# 일일 전체 변환 총량 캡 (비용 방어용 2차 방어선)
DAILY_TOTAL_CAP=500

# Upstash Redis — rate limit 영속화 (console.upstash.com 또는 로컬 수동 설정용)
# Vercel-Upstash 연동 시 KV_REST_API_URL/KV_REST_API_TOKEN 이 자동 주입되며
# 코드가 이를 폴백으로 읽으므로, 그 경우 아래 두 변수는 별도로 추가하지 않아도 됨.
# 미설정 시 in-memory 폴백으로 동작하지만 서버리스 환경에서는 비용 방어가 되지 않음.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — 결과 이미지 영속화. Vercel 대시보드에서 Blob 스토어 연결 시 자동 주입
# 미설정 시 Replicate 임시 URL(약 1시간 후 만료) 그대로 반환
BLOB_READ_WRITE_TOKEN=
